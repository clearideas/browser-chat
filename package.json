{
  "name": "@clearideas/chat",
  "version": "0.1.0",
  "description": "Standalone chat widget for Clear Ideas platform",
  "type": "module",
  "main": "./dist/clearideas-widget.cjs",
  "module": "./dist/clearideas-widget.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/clearideas-widget.es.js",
      "require": "./dist/clearideas-widget.cjs"
    },
    "./ClearIdeasWidgetStandalone.vue": "./src/ClearIdeasWidgetStandalone.vue",
    "./theme": "./src/theme.ts",
    "./types": "./src/types.ts",
    "./style.css": "./dist/clearideas-widget.css"
  },
  "files": [
    "dist/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:serve": "vite --port 8000",
    "test:serve:static": "python3 -m http.server 8000 || python -m http.server 8000 || npx serve .",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:watch": "vitest",
    "check:package": "node scripts/check-package.mjs",
    "check": "npm run lint && npm run type-check && npm test && npm run build && npm run check:package",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "clearideas",
    "chat",
    "widget",
    "vue3",
    "ai-chat"
  ],
  "author": "Clear Ideas",
  "license": "MIT",
  "dependencies": {
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.3",
    "tippy.js": "^6.3.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.1.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-vue": "^10.12.0",
    "jsdom": "^31.0.0",
    "msw": "^3.0.4",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "terser": "^5.51.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0",
    "npm": ">=10.8.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clearideas/browser-chat.git"
  },
  "bugs": {
    "url": "https://github.com/clearideas/browser-chat/issues"
  },
  "homepage": "https://github.com/clearideas/browser-chat#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "peerDependencies": {
    "vue": "^3.5.45"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "overrides": {
    "minimatch": "^11.0.5",
    "glob": "^14.0.4"
  }
}
