{
  "name": "@clearideas/chat",
  "version": "0.1.1",
  "description": "Standalone chat widget for the Clear Ideas\u00ae platform",
  "type": "module",
  "main": "./dist/clearideas-widget.cjs",
  "module": "./dist/clearideas-widget.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/clearideas-widget.es.js",
      "require": "./dist/clearideas-widget.cjs"
    },
    "./ClearIdeasWidgetStandalone.vue": "./src/ClearIdeasWidgetStandalone.vue",
    "./theme": "./src/theme.ts",
    "./types": "./src/types.ts",
    "./style.css": "./dist/clearideas-widget.css"
  },
  "files": [
    "dist/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "dev": "node scripts/dev.mjs",
    "dev:package": "CLEARIDEAS_PACKAGE_DEV=1 node scripts/dev.mjs",
    "server": "node server/cli.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "vue-tsc --noEmit",
    "test": "npm run test:unit && npm run test:server && npm run test:live",
    "test:unit": "vitest run --project unit",
    "test:server": "vitest run --project server",
    "test:conformance": "vitest run --project server tests/conformance",
    "test:live": "vitest run --project live",
    "test:e2e": "npm run build && playwright test",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "check": "npm run lint && npm run type-check && npm test && npm run build && npm run check:package",
    "check:package": "node scripts/check-package.mjs",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "clearideas",
    "chat",
    "widget",
    "vue3",
    "ai-chat"
  ],
  "author": "Clear Ideas",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/test-utils": "^2.5.1",
    "axe-core": "^4.14.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-vue": "^10.12.0",
    "jsdom": "^30.1.3",
    "msw": "^3.0.3",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "terser": "^5.51.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "vue": "^3.5.44",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0",
    "npm": ">=10.8.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clearideas/chat.git"
  },
  "bugs": {
    "url": "https://github.com/clearideas/chat/issues"
  },
  "homepage": "https://github.com/clearideas/chat#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "peerDependencies": {
    "vue": "^3.5.44"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "overrides": {
    "minimatch": "^11.0.4",
    "glob": "^14.0.3",
    "rolldown": "1.2.15"
  }
}
